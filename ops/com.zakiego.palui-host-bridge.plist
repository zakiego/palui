<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Palui host bridge: an MCP server on 127.0.0.1:4893 that runs an allowlist of
  host commands for the runtime container. Template: ops/install-host-bridge.sh
  replaces __HOME__ and __NODE__ and installs it into ~/Library/LaunchAgents.
  The allowlist lives in ~/.config/palui/host-bridge.json.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zakiego.palui-host-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__HOME__/selfhost/bin/palui-host-bridge.mjs</string>
    <string>serve</string>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/selfhost/palui-host-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/selfhost/palui-host-bridge.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A bad config exits at once; don't spin on it. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
