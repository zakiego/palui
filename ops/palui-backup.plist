<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly Palui backup to R2. Template: ops/install-backup.sh replaces
  __LABEL__, __HOST_DIR__ and __PALUI_DIR__ and installs it into
  ~/Library/LaunchAgents.
  A LaunchAgent runs in the login session, so the Keychain is unlocked. If the
  Mac is asleep at 03:30, launchd runs the job when it wakes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOST_DIR__/bin/palui-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PALUI_DIR</key>
    <string>__PALUI_DIR__</string>
  </dict>
  <!-- The script logs to this file itself; these catch anything before that. -->
  <key>StandardOutPath</key>
  <string>__HOST_DIR__/palui-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOST_DIR__/palui-backup.log</string>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
