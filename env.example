# Copy to a file named ".env" next to compose.yaml and fill in the two
# required keys. Every other credential (model keys, bot tokens, MCP tokens) is
# entered in the dashboard and stored encrypted in the database, never here.

# Required in production. Encrypts every connector secret (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Keep a copy in your password manager: a backup can't be decrypted without it.
MASTER_KEY=replace-with-openssl-rand-base64-32

# Required. Public origin of the dashboard: cookies, the passkey domain and
# invite links. Use a host name, passkeys don't work on an IP address.
APP_URL=https://palui.example.com

# Optional. Default time zone for reminders and schedules (IANA name).
# PALUI_TZ=Asia/Makassar

# Optional. debug, info (default), warn or error.
# LOG_LEVEL=info

# Optional. Comma-separated sha256 hashes of your production channel tokens.
# A dev server refuses a channel whose token matches one, so a local run
# can't take over the production bot's connection.
# PALUI_PROD_TOKEN_HASHES=

# The Docker image already sets these. Change them only when you run the
# binary directly.
# NODE_ENV=production   # prod mode: MASTER_KEY required, dev fixtures off
# HOST=0.0.0.0
# PORT=3000
# DATA_DIR=/data        # palui.db, wa/ (WhatsApp sessions), backups/
# PALUI_WEB_DIR=        # serve the dashboard from a directory instead of the embedded build
# PALUI_NO_RUNTIME=     # 1 serves the dashboard and API without channels or schedulers
